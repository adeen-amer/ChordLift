# Leave empty to use Vite dev proxy (npm run dev) or nginx in Docker
VITE_API_BASE=

# "true" hides the URL input, leaving file upload as the only way in.
# Set on the Cloudflare Pages production build (dashboard env vars, not this
# file) -- Vite gives real process env vars priority over .env files, so
# setting it here will NOT override the dashboard value.
VITE_UPLOAD_ONLY=false
